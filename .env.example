# ── Google Earth Engine ───────────────────────────────────────────────────────
# Gunakan service account untuk production (bukan personal account)
# Cara buat: https://developers.google.com/earth-engine/guides/service_account
GEE_SERVICE_ACCOUNT=palmwatch@your-project.iam.gserviceaccount.com
GEE_KEY_FILE=config/gee-key.json
GEE_PROJECT=your-gcp-project-id

# ── Supabase (backend basis data, lihat supabase/) ───────────────────────────
# Dashboard Settings -> API:
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
# Untuk CLI: Account -> Access Tokens
SUPABASE_ACCESS_TOKEN=your-access-token
SUPABASE_PROJECT_REF=your-project-ref
SUPABASE_DB_PASSWORD=your-db-password
# Connection string URI (Settings -> Database -> Connection string -> URI).
# Dipakai scripts/load_seed.py untuk memuat seed tanpa psql.
SUPABASE_DB_URL=postgresql://postgres.your-project-ref:YOUR-DB-PASSWORD@aws-1-<region>.pooler.supabase.com:5432/postgres

# ── PostgreSQL / PostGIS (pipeline menulis ke Supabase Postgres) ──────────────
# Settings -> Database -> Connection info / Connection string.
# Gunakan host pooler (port 6543) untuk koneksi dari skrip batch.
POSTGIS_HOST=db.your-project-ref.supabase.co
POSTGIS_PORT=5432
POSTGIS_DB=postgres
POSTGIS_USER=postgres
POSTGIS_PASSWORD=your_supabase_db_password

# ── SoilGrids ISRIC ───────────────────────────────────────────────────────────
# Tidak butuh API key — public REST API
# https://rest.isric.org/soilgrids/v2.0/docs
SOILGRIDS_BASE_URL=https://rest.isric.org/soilgrids/v2.0

# ── NASA CMR (untuk SMAP) ─────────────────────────────────────────────────────
# Daftar di https://urs.earthdata.nasa.gov/
NASA_EARTHDATA_USER=your_earthdata_username
NASA_EARTHDATA_PASSWORD=your_earthdata_password

# ── CHIRPS (CHC UCSB) ────────────────────────────────────────────────────────
# Tidak butuh API key — public FTP/HTTP
CHIRPS_BASE_URL=https://data.chc.ucsb.edu/products/CHIRPS-2.0

# ── Pipeline Config ───────────────────────────────────────────────────────────
LOG_LEVEL=INFO
OUTPUT_DIR=results/
CACHE_DIR=cache/
MAX_WORKERS=4
RETRY_ATTEMPTS=3
RETRY_DELAY_SECONDS=10
